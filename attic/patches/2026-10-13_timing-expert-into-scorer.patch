@@ -0,0 +1,57 @@
+"""A timing expert fused into the context head: the null expert leaves every head's log-probabilities as they are."""
+
+import json
+from dataclasses import dataclass
+
+import torch
+from jaxtyping import Float
+from torch import Tensor
+
+from core.paths import DataRoot
+from megspeech.data.batching.split import Split
+from megspeech.data.config import METRICS
+from megspeech.data.labels.vocabulary import VOCAB_SIZE
+from megspeech.data.spans.spans import PAD
+from megspeech.evaluation.scoring.score import Head
+from megspeech.model.context.timing_only import FILE, TimingOnly
+
+
+@dataclass(frozen=True)
+class Expert:
+    """No expert: `fused` returns the log-probabilities it is given."""
+
+    def fused(self, logits: dict[Head, Float[Tensor, "n v"]], split: Split) -> dict[Head, Float[Tensor, "n v"]]:
+        return logits
+
+    @staticmethod
+    def of(root: DataRoot, name: str, weight: float, device: torch.device) -> "Expert":
+        """The expert `name` under models/ at `weight`, or no expert when `name` is empty."""
+        return Timing.load(root, name, weight, device) if name else Expert()
+
+
+@dataclass(frozen=True)
+class Timing(Expert):
+    """A trained timing expert, read as every word's log-probability over the vocabulary, added to the context head
+    `weight` times."""
+
+    model: TimingOnly
+    weight: float
+
+    @classmethod
+    def load(cls, root: DataRoot, name: str, weight: float, device: torch.device) -> "Timing":
+        layers = json.loads((root.models() / name / METRICS).read_text())["expert"].get("layers", 0)
+        model = TimingOnly(VOCAB_SIZE, layers)
+        model.timing.load_state_dict(torch.load(root.models() / name / FILE, weights_only=True))
+        return cls(model.to(device).eval(), weight)
+
+    def words(self, split: Split) -> Float[Tensor, "n v"]:
+        """Each of `split`'s words' log-probabilities from its span's onsets; zero for words no span holds."""
+        mask = split.index != PAD
+        with torch.no_grad():
+            logp = self.model.timing(split.onset, mask).float().log_softmax(-1)
+        out = torch.zeros(len(split.y), logp.shape[-1], device=logp.device)
+        out[split.index[mask]] = logp[mask]
+        return out
+
+    def fused(self, logits: dict[Head, Float[Tensor, "n v"]], split: Split) -> dict[Head, Float[Tensor, "n v"]]:
+        return {**logits, Head.CONTEXT: logits[Head.CONTEXT] + self.weight * self.words(split)}
