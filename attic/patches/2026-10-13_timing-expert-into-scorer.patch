diff --git a/tests/unit/megspeech/evaluation/scoring/expert.py b/tests/unit/megspeech/evaluation/scoring/expert.py
new file mode 100644
index 0000000..baa8362
--- /dev/null
+++ b/tests/unit/megspeech/evaluation/scoring/expert.py
@@ -0,0 +1,70 @@
+import json
+from pathlib import Path
+
+import torch
+from jaxtyping import Float
+from torch import Tensor
+
+from core.paths import DataRoot
+from megspeech.data.batching.split import Split
+from megspeech.data.config import METRICS
+from megspeech.data.constants import CHANNELS
+from megspeech.data.labels.vocabulary import VOCAB_SIZE
+from megspeech.data.spans.spans import Spans
+from megspeech.evaluation.scoring.expert import Expert, Timing
+from megspeech.evaluation.scoring.score import Head
+from megspeech.model.context.timing_only import FILE, TimingOnly
+
+CPU = torch.device("cpu")
+ROWS = 6
+WEIGHT = 0.5
+
+
+def split() -> Split:
+    onset = torch.arange(ROWS, dtype=torch.float64).numpy() * 0.2 + (torch.arange(ROWS) // 3).numpy() * 5.0
+    return Split.from_arrays(
+        torch.zeros(ROWS, CHANNELS, 4).numpy(), (torch.arange(ROWS) % 3).numpy(), Spans.by_gap(onset), CPU
+    )
+
+
+def logits() -> dict[Head, Float[Tensor, "n v"]]:
+    return {head: torch.randn(ROWS, VOCAB_SIZE).log_softmax(-1) for head in Head}
+
+
+def timing(weight: float = WEIGHT) -> Timing:
+    return Timing(TimingOnly(VOCAB_SIZE, layers=1).eval(), weight)
+
+
+def test_words() -> None:
+    """Every spanned word gets a normalised row over the vocabulary, in the split's word order."""
+    words = timing().words(split())
+    assert words.shape == (ROWS, VOCAB_SIZE)
+    assert torch.allclose(words.exp().sum(-1), torch.ones(ROWS))
+
+
+def test_fused() -> None:
+    """No expert returns the logits as given; a weighted one moves the context head only; weight 0 moves nothing."""
+    given = logits()
+    assert Expert().fused(given, split()) is given
+    expert = timing()
+    out = expert.fused(given, split())
+    assert torch.allclose(out[Head.CONTEXT], given[Head.CONTEXT] + WEIGHT * expert.words(split()))
+    assert not torch.equal(out[Head.CONTEXT], given[Head.CONTEXT])
+    assert torch.equal(out[Head.WORD], given[Head.WORD])
+    assert torch.equal(timing(0.0).fused(given, split())[Head.CONTEXT], given[Head.CONTEXT])
+
+
+def test_load(tmp_path: Path) -> None:
+    root = DataRoot(tmp_path)
+    directory = root.models() / "t"
+    directory.mkdir(parents=True)
+    saved = TimingOnly(VOCAB_SIZE, layers=1).timing.state_dict()
+    torch.save(saved, directory / FILE)
+    (directory / METRICS).write_text(json.dumps({"expert": {"layers": 1}}))
+    loaded = Timing.load(root, "t", WEIGHT, CPU)
+    assert loaded.weight == WEIGHT
+    assert all(torch.equal(loaded.model.timing.state_dict()[key], value) for key, value in saved.items())
+
+
+def test_of(tmp_path: Path) -> None:
+    assert Expert.of(DataRoot(tmp_path), "", WEIGHT, CPU) == Expert()
